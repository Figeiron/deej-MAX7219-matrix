<Window x:Class="VolumeOsd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Opacity="0">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="OsdBackground" Color="#F22B2B2B" />
        <SolidColorBrush x:Key="OsdBorder" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="OsdForeground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="OsdSecondary" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="OsdTrack" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="OsdAccent" Color="#FF60CDFF" />
        <SolidColorBrush x:Key="OsdMuted" Color="#73FFFFFF" />
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow -->
    <ItemsControl x:Name="Rows" Margin="20" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="340" Height="60" Margin="0,4" CornerRadius="10" Padding="16,0"
                        Background="{DynamicResource OsdBackground}"
                        BorderBrush="{DynamicResource OsdBorder}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.35" />
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}"
                                       FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="{DynamicResource OsdForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource OsdForeground}" />

                            <Grid Height="4" Margin="0,9,0,0">
                                <Border CornerRadius="2" Background="{DynamicResource OsdTrack}" />
                                <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource OsdAccent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource OsdMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Volume}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding PercentText}" Visibility="{Binding PercentVisibility}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OsdSecondary}" />
                        <TextBlock Grid.Column="2" Text="&#xE74F;" Visibility="{Binding MuteVisibility}"
                                   FontFamily="{StaticResource IconFont}" FontSize="18"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OsdSecondary}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
